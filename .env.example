# ──────────────────────────────────────────────────────────────────────────
# The Football Final Whistle — agent configuration
# Copy to .env for local runs. In production, set these as GitHub Actions
# secrets/variables (see docs/DEPLOYMENT.md). Everything has a safe default;
# the agent runs end-to-end in DRY_RUN mode with only FOOTBALL_DATA_TOKEN set.
# ──────────────────────────────────────────────────────────────────────────

# ── Safety ────────────────────────────────────────────────────────────────
# While true, posts are generated, rendered and logged but NEVER published.
DRY_RUN=true

# Minimum confidence (0–1) a claim needs before a post is queued.
# Anything below is logged as "skipped_low_confidence" and never posted.
MIN_CONFIDENCE=0.8

# ── Sports data (required) ────────────────────────────────────────────────
# Free key: https://www.football-data.org/client/register  (10 req/min tier)
FOOTBALL_DATA_TOKEN=

# Comma-separated football-data.org competition codes to monitor.
# PL=Premier League, CL=Champions League, WC=World Cup, EC=Euros,
# FL1=Ligue 1, BL1=Bundesliga, SA=Serie A, PD=La Liga
COMPETITIONS=PL,CL,WC

# TheSportsDB (second source for result verification). "3" is the free
# community key — works out of the box. https://www.thesportsdb.com/free_sports_api
THESPORTSDB_KEY=3

# ── News sources (no keys needed) ─────────────────────────────────────────
# Comma-separated RSS feeds. Defaults cover BBC, Sky, Guardian, ESPN.
# Override only if you want different sources.
#RSS_FEEDS=

# ── Captions (optional — template fallback used when unset) ──────────────
# https://platform.claude.com — used to write captions in the brand voice.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# ── Publishing (pick one; leave PUBLISHER=none to only build the queue) ──
# none      — generate + queue only (default)
# buffer    — publish via Buffer (works with your existing Buffer account)
# instagram — publish directly via the Instagram Graph API (free, needs a
#             Business/Creator IG account linked to a Facebook Page + app)
PUBLISHER=none

# Buffer: create a token at https://publish.buffer.com/settings/api
BUFFER_ACCESS_TOKEN=
BUFFER_CHANNEL_ID=

# Instagram Graph API
IG_USER_ID=
IG_ACCESS_TOKEN=

# Public base URL for generated images (Instagram/Buffer fetch media by URL).
# When running in GitHub Actions on a PUBLIC repo this is derived
# automatically from raw.githubusercontent.com — leave blank.
#MEDIA_BASE_URL=

# ── Posting cadence / rate limits ─────────────────────────────────────────
MAX_POSTS_PER_RUN=3
MIN_MINUTES_BETWEEN_POSTS=20
MAX_POSTS_PER_DAY=12

# ── Brand ─────────────────────────────────────────────────────────────────
BRAND_HANDLE=@thefootballfinalwhistle
BRAND_NAME=The Football Final Whistle
